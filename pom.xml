<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- the same release parent the Business Cockpit itself uses, because these artifacts are
       released to Maven Central under the cockpit's groupId and have to be signed and
       accompanied by sources and javadoc the way the rest of the cockpit is -->
  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.1.1</version>
  </parent>

  <groupId>io.vanillabp.businesscockpit</groupId>
  <artifactId>businesscockpit-process-engine-api-adapter-parent</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP Business Cockpit adapter for the Process-Engine-API</name>
  <description>Business Cockpit integration for the bpm-crafters Process-Engine-API, built as a VanillaBP 2 extension.</description>
  <url>https://github.com/vanillabp/businesscockpit-process-engine-api-adapter</url>

  <modules>
    <module>core</module>
    <module>spring-boot</module>
    <module>quarkus</module>
    <!-- last: it judges the reports the modules above produced -->
    <module>test-coverage-report</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/vanillabp/businesscockpit-process-engine-api-adapter.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/businesscockpit-process-engine-api-adapter.git</developerConnection>
    <url>https://github.com/vanillabp/businesscockpit-process-engine-api-adapter/tree/main</url>
  </scm>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/businesscockpit-process-engine-api-adapter</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <version.java>21</version.java>
    <maven.compiler.release>21</maven.compiler.release>
    <jacoco.version>0.8.15</jacoco.version>
    <lombok.version>1.18.48</lombok.version>
    <spi-for-java.version>1.2.0-SNAPSHOT</spi-for-java.version>
    <adapter-platform.version>2.0.0-SNAPSHOT</adapter-platform.version>
    <!-- the VanillaBP Process-Engine-API adapter this extension plugs into: it names the
         processing context the extension is wired with -->
    <process-engine-api-adapter.version>2.0.0-SNAPSHOT</process-engine-api-adapter.version>
    <!-- the Process-Engine-API itself: this extension reads the task information an engine
         delivers, so it compiles against the same version the adapter does -->
    <process-engine-api.version>1.7</process-engine-api.version>
    <!-- the Business Cockpit itself: extensions-commons is the platform-neutral half of
         this extension and is consumed as a published artifact, never copied -->
    <business-cockpit.version>0.9.0-SNAPSHOT</business-cockpit.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <quarkus.version>3.39.2</quarkus.version>
    <!-- where the build stops, the same number in every VanillaBP repository -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- what a report is expected to show: reported every run, never asserted, so a bad
         week is not answered by editing a number -->
    <coverage.rule>90</coverage.rule>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- one place for every io.vanillabp coordinate of the Version 2 platform: the SPI an
           extension implements, the core runtime it reads its configuration from, the platform
           integrations the per-platform modules register with, and the test harness. The
           adapter SPI is in here as well, although it is written for BPMS adapters: it carries
           the name-clash avoidance, and this extension has to spell a process id the way the
           engine of a workflow module was given it. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${adapter-platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- the platform-neutral half of this extension, and the two modules registering it
           on Spring Boot and on Quarkus -->
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-spring-boot</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-quarkus</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-quarkus-deployment</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>process-engine-api-adapter</artifactId>
        <version>${process-engine-api-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>process-engine-api-adapter-spring-boot</artifactId>
        <version>${process-engine-api-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>process-engine-api-adapter-quarkus</artifactId>
        <version>${process-engine-api-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>process-engine-api-adapter-quarkus-deployment</artifactId>
        <version>${process-engine-api-adapter.version}</version>
      </dependency>
      <dependency>
        <!-- the in-memory engine the adapter ships for running without a real one; a test of
             this repository subscribes to it to show what the API delivers to whom -->
        <groupId>io.vanillabp</groupId>
        <artifactId>process-engine-api-mock</artifactId>
        <version>${process-engine-api-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.bpm-crafters.process-engine-api</groupId>
        <artifactId>process-engine-api</artifactId>
        <version>${process-engine-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <optional>true</optional>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- pinned here rather than left to the parent's default: the coverage-report
               modules turn it off, and a plugin whose version is decided by whichever Maven
               runs the build is a build which differs between a laptop and the pipeline -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- '@{jacoco.agent}' is resolved lazily per module (late property binding),
                 forwarding coverage also into forked JVMs -->
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <compilerArgs>
              <!-- a javadoc which names a method is checked like any other claim: a link
                   the compiler cannot resolve is an error, a parameter documented twice a
                   warning. Only the reference group is on, so wording and missing comments
                   stay a matter of review. -->
              <arg>-Xdoclint:reference</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.agent</propertyName>
          <excludes>
            <exclude>**/it/**</exclude>
            <exclude>**/test/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- Workflow files are excluded on purpose, the same way the other adapter
                   repositories do it: the formatter drops comments, and it unquotes version
                   numbers. -->
              <exclude>**/.github/**/</exclude>
              <exclude>.github/workflows/**</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
